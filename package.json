{
  "name": "skyra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "tsc --build",
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "lint:fix": "npm run lint:oxlint:fix && npm run lint:eslint:fix",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:eslint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix --cache",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/vazirmatn": "^5.2.8",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/x-charts": "^9.18.1",
    "axios": "^1.21.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.13.1",
    "stylis": "^4.2.0",
    "stylis-plugin-rtl": "^2.1.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
